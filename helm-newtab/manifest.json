{
  "manifest_version": 3,
  "name": "Helm — Todos & Agents",
  "short_name": "Helm",
  "version": "0.1.0",
  "description": "Your new tab: a focused todo list plus a live view of what your coding agents are doing.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Helm — open dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "favicon"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
