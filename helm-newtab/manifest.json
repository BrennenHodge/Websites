{
  "manifest_version": 3,
  "name": "Helm \u2014 Agent Tasks",
  "short_name": "Helm",
  "version": "0.2.0",
  "description": "Your new tab: a task list where every task is routed to the right AI agent, and you can watch each one get done.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Helm \u2014 open dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "favicon",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
